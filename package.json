{
  "name": "@mou652/commit-policy",
  "version": "0.1.0",
  "private": true,
  "description": "Public local Git commit policies powered by Lefthook and commitlint",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/install.mjs",
    "java:prepare": "node scripts/java-tools.mjs",
    "java:check": "node scripts/java-check.mjs",
    "java:audit": "node scripts/java-check.mjs --all"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "lefthook": "2.1.15"
  }
}
